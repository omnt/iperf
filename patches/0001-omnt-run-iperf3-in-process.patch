diff -ruN a/src/iperf_pthread.c b/src/iperf_pthread.c
--- a/src/iperf_pthread.c
+++ b/src/iperf_pthread.c
@@ -6,6 +6,17 @@
  * as Android NDK does not support `pthread_cancel()`.
  */
 
+/*
+ * OMNT: not SIGUSR1. In an app process ART owns SIGUSR1 and blocks it in every
+ * thread started from Java; stream threads inherit that mask, so a SIGUSR1
+ * "cancel" stays pending forever and pthread_join() hangs (e.g. a UDP server
+ * receiver blocked in recv() at the end of a test). Installing a handler would
+ * also replace ART's SIGUSR1 disposition process-wide. SIGRTMIN is free for
+ * apps (bionic keeps its own real-time signals below it); the embedder
+ * unblocks it in the thread that starts the test.
+ */
+#define IPERF_THREAD_EXIT_SIGNAL SIGRTMIN
+
 #include <string.h>
 #include <signal.h>
 #include "iperf_pthread.h"
@@ -24,7 +35,7 @@
     actions.sa_flags = 0;
     actions.sa_handler = iperf_thread_exit_handler;
 
-    rc = sigaction(SIGUSR1, &actions, NULL);
+    rc = sigaction(IPERF_THREAD_EXIT_SIGNAL, &actions, NULL);
     return rc;
 }
 
@@ -33,7 +44,7 @@
 int pthread_cancel(pthread_t thread_id) {
     int status;
     if ((status = iperf_set_thread_exit_handler()) == 0) {
-        status = pthread_kill(thread_id, SIGUSR1);
+        status = pthread_kill(thread_id, IPERF_THREAD_EXIT_SIGNAL);
     }
     return status;
 }
