diff -ruN a/src/main.h b/src/main.h
--- a/src/main.h	1970-01-01 00:00:00.000000000 +0000
+++ b/src/main.h	2026-11-12 14:26:55.611788911 +0000
@@ -0,0 +1,33 @@
+/*
+ * OMNT (OpenMobileNetworkToolkit) additions for running iperf3 in-process
+ * from a JNI wrapper on Android instead of as a standalone binary.
+ *
+ * iperf3 calls exit() on a few "normal" paths (-v, -h, usage errors,
+ * one-off idle timeout). Inside an app that would kill the hosting
+ * process, so those paths use IPERF_EXIT(), which longjmp()s back into
+ * main() and returns the exit code to the caller instead.
+ */
+#ifndef IPERF_MAIN_H
+#define IPERF_MAIN_H
+
+#include <setjmp.h>
+#include <stdlib.h>
+
+#include "iperf.h"
+
+extern jmp_buf jmp_bf;
+extern struct iperf_test *test;
+
+/* setjmp() cannot return 0 via longjmp(), so exit codes are offset. */
+#define IPERF_EXIT_JMP_BASE 0x100
+
+#ifdef __ANDROID__
+#define IPERF_EXIT(code) longjmp(jmp_bf, IPERF_EXIT_JMP_BASE + (code))
+#else
+#define IPERF_EXIT(code) exit(code)
+#endif
+
+int main(int argc, char **argv);
+void stopRun(void);
+
+#endif /* IPERF_MAIN_H */
