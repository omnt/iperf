diff -ruN a/src/omnt_exit.h b/src/omnt_exit.h
--- a/src/omnt_exit.h
+++ b/src/omnt_exit.h
@@ -0,0 +1,29 @@
+/*
+ * OMNT (OpenMobileNetworkToolkit) addition for running iperf3 in-process
+ * on Android through libiperf's API (see jni/iperf3_jni.c in omnt/iperf).
+ *
+ * iperf3 calls exit() on a few "normal" paths (-v, -h, usage errors,
+ * one-off idle timeout) and, via iperf_exit(), on every fatal error
+ * (server busy, connection refused or reset, ...). Inside an app that
+ * would kill the hosting process, so those paths use IPERF_EXIT(). The
+ * embedder provides iperf_exit_jump(), which longjmp()s back to where it
+ * started the test and returns the exit code to its caller instead.
+ */
+#ifndef IPERF_OMNT_EXIT_H
+#define IPERF_OMNT_EXIT_H
+
+#ifdef __ANDROID__
+/*
+ * Must not return. Implementations jump back to the embedder when called
+ * on the thread running the test, and fall back to exit() otherwise (e.g.
+ * from a stream thread), since longjmp() to another thread's stack is
+ * undefined.
+ */
+void iperf_exit_jump(int code) __attribute__ ((noreturn));
+#define IPERF_EXIT(code) iperf_exit_jump(code)
+#else
+#include <stdlib.h>
+#define IPERF_EXIT(code) exit(code)
+#endif
+
+#endif /* IPERF_OMNT_EXIT_H */
